{
  "name": "proof-relay-mwe",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "description": "A HugoBlox MWE for publishing reproducible AI-assisted proof runs",
  "scripts": {
    "postinstall": "node scripts/link-tailwind-cli.mjs",
    "prepare:projects": "python3 scripts/prepare_projects.py --generate",
    "check:projects": "python3 scripts/prepare_projects.py --check",
    "check:site": "python3 scripts/check_site.py --site public",
    "test": "python3 -m unittest discover -s tests -v",
    "dev": "python3 scripts/prepare_projects.py --generate && hugo server --disableFastRender",
    "build": "python3 scripts/prepare_projects.py --generate && hugo --minify --cleanDestinationDir && pnpm run pagefind && pnpm run check:site",
    "pagefind": "pagefind --site public"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/typography": "^0.5.10",
    "pagefind": "^1.4.0",
    "preact": "^10.27.2",
    "tailwindcss": "^4.1.12"
  }
}
