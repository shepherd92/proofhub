{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof-relay.example/schemas/status-v1.schema.json",
  "title": "Proof Relay project status v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "current_run",
    "as_of_runs",
    "outcome",
    "verification",
    "summary",
    "established",
    "candidate_results",
    "special_cases",
    "failed_attempts",
    "open_goals",
    "recommended_next_steps",
    "extensions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "current_run": { "$ref": "#/$defs/id" },
    "as_of_runs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "outcome": { "$ref": "#/$defs/outcome" },
    "verification": { "$ref": "#/$defs/verification" },
    "summary": { "type": "string", "minLength": 1 },
    "established": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "candidate_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "special_cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "failed_attempts": {
      "type": "array",
      "items": { "$ref": "#/$defs/failed_attempt" }
    },
    "open_goals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "recommended_next_steps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "review": { "$ref": "#/$defs/review" },
    "extensions": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": { "enum": ["proved", "refuted"] }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "verification": {
            "enum": ["machine_checked", "supervisor_reviewed"]
          },
          "established": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": { "const": "supervisor_reviewed" }
        },
        "required": ["verification"]
      },
      "then": {
        "required": ["review"]
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "no_progress",
        "partial",
        "candidate_proof",
        "proved",
        "candidate_refutation",
        "refuted"
      ]
    },
    "verification": {
      "type": "string",
      "enum": [
        "unverified",
        "failed",
        "agent_reported",
        "reproduced",
        "machine_checked",
        "supervisor_reviewed"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "evidence"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "failed_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approach", "scope", "reason"],
      "properties": {
        "approach": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_at"],
      "properties": {
        "reviewed_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Optional explicit reviewer when the reviewer differs from the Git commit author."
        },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "note": { "type": ["string", "null"] }
      }
    }
  }
}
