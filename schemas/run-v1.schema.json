{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proof-relay.example/schemas/run-v1.schema.json",
  "title": "Proof Relay run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "parents",
    "submitted_by",
    "execution",
    "agent",
    "models",
    "configuration",
    "environment",
    "result",
    "files",
    "publication",
    "extensions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "$ref": "#/$defs/id" },
    "parents": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/parent" }
    },
    "submitted_by": { "type": "string", "minLength": 1 },
    "execution": { "$ref": "#/$defs/execution" },
    "agent": { "$ref": "#/$defs/agent" },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    },
    "configuration": { "$ref": "#/$defs/configuration" },
    "environment": { "$ref": "#/$defs/environment" },
    "result": { "$ref": "#/$defs/result" },
    "files": { "$ref": "#/$defs/files" },
    "publication": { "$ref": "#/$defs/publication" },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "nullable_string": {
      "type": ["string", "null"]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "no_progress",
        "partial",
        "candidate_proof",
        "proved",
        "candidate_refutation",
        "refuted"
      ]
    },
    "verification": {
      "type": "string",
      "enum": [
        "unverified",
        "failed",
        "agent_reported",
        "reproduced",
        "machine_checked",
        "supervisor_reviewed"
      ]
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "relation"],
      "properties": {
        "run_id": { "$ref": "#/$defs/id" },
        "relation": {
          "type": "string",
          "enum": ["continuation", "retry", "fork", "merge", "import"]
        },
        "checkpoint": { "$ref": "#/$defs/nullable_string" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "started_at", "ended_at", "wall_seconds"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["completed", "aborted", "failed", "imported"]
        },
        "started_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "ended_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "wall_seconds": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "version", "architecture"],
      "properties": {
        "framework": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/nullable_string" },
        "architecture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "description"],
          "properties": {
            "type": { "$ref": "#/$defs/id" },
            "description": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "snapshot", "role", "parameters"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "snapshot": { "$ref": "#/$defs/nullable_string" },
        "role": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_iterations",
        "token_budget",
        "concurrency",
        "tools",
        "extensions"
      ],
      "properties": {
        "maximum_iterations": { "type": ["integer", "null"], "minimum": 0 },
        "token_budget": { "type": ["integer", "null"], "minimum": 0 },
        "concurrency": { "type": ["integer", "null"], "minimum": 1 },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "$ref": "#/$defs/nullable_string" }
            }
          }
        },
        "extensions": { "type": "object" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_repository", "source_commit", "dependency_lockfiles"],
      "properties": {
        "source_repository": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        },
        "source_commit": { "$ref": "#/$defs/nullable_string" },
        "dependency_lockfiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "verification",
        "summary",
        "verification_command",
        "verification_log"
      ],
      "properties": {
        "outcome": { "$ref": "#/$defs/outcome" },
        "verification": { "$ref": "#/$defs/verification" },
        "summary": { "type": "string", "minLength": 1 },
        "verification_command": { "$ref": "#/$defs/nullable_string" },
        "verification_log": { "$ref": "#/$defs/nullable_string" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": { "enum": ["proved", "refuted"] }
            },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "verification": {
                "enum": ["machine_checked", "supervisor_reviewed"]
              },
              "verification_log": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": { "enum": ["proved", "refuted"] },
              "verification": { "const": "machine_checked" }
            },
            "required": ["outcome", "verification"]
          },
          "then": {
            "properties": {
              "verification_command": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "output", "events", "artifacts"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "output": { "type": "string", "minLength": 1 },
        "events": { "type": "string", "minLength": 1 },
        "artifacts": { "type": "string", "minLength": 1 }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redaction_reviewed"],
      "properties": {
        "redaction_reviewed": { "const": true }
      }
    }
  }
}
